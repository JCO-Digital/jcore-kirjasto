msgid "Last built %s. Changes to content are indexed as they are saved."
msgstr "Rakennettu viimeksi %s. Sisällön muutokset indeksoidaan tallennettaessa."

#: build/usage-page.js:2
msgid "The index has not been built yet. Until it is, attachments may show as not used even though they are."
msgstr "Hakemistoa ei ole vielä rakennettu. Siihen asti tiedostot voivat näkyä käyttämättöminä, vaikka niitä käytetään."

#. translators: 1: items scanned so far, 2: items in total
#: build/usage-page.js:3
msgid "%1$s of %2$s items scanned"
msgstr "%1$s / %2$s kohdetta käyty läpi"

#: build/usage-page.js:3
msgid "Failed to start the rebuild."
msgstr "Uudelleenrakennuksen aloittaminen epäonnistui."

#: build/usage-page.js:3
msgid "Rebuilding…"
msgstr "Rakennetaan…"

#: build/usage-page.js:3
msgid "Rebuild index"
msgstr "Rakenna hakemisto uudelleen"

#: build/usage-page.js:3
msgid "Only needed after content was changed directly in the database, e.g. by an import or a search-replace."
msgstr "Tarpeen vain, jos sisältöä on muutettu suoraan tietokannassa, esim. tuonnilla tai hae-ja-korvaa-toiminnolla."

#: build/usage-page.js:3
msgid "Summary"
msgstr "Yhteenveto"

